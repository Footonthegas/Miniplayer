# Supabase project settings. Keep the service-role key on the server only.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Razorpay API credentials. Never put RAZORPAY_KEY_SECRET in extension files.
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_PLAN_ID=plan_YOUR_PLAN_ID
# REQUIRED: total number of billing cycles for this subscription. Configure this to match the plan you intend to sell.
RAZORPAY_TOTAL_COUNT=12

# Secret you create when registering your webhook in Razorpay Dashboard.
RAZORPAY_WEBHOOK_SECRET=CREATE_A_LONG_RANDOM_WEBHOOK_SECRET

PORT=3000
